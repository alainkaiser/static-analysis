{
  "name": "@alainkaiser/static-analysis",
  "version": "0.1.0",
  "description": "Shared static analysis setup: Oxlint and Oxfmt configs",
  "private": true,
  "type": "module",
  "exports": {
    "./doctor": {
      "types": "./doctor.d.ts",
      "default": "./doctor.js"
    },
    "./oxfmt": {
      "types": "./oxfmt.d.ts",
      "default": "./oxfmt.js"
    },
    "./oxlint": {
      "types": "./oxlint.d.ts",
      "default": "./oxlint.js"
    },
    "./tsconfig": "./tsconfig.json"
  },
  "files": [
    "doctor.js",
    "doctor.d.ts",
    "oxfmt.js",
    "oxfmt.d.ts",
    "oxlint.js",
    "oxlint.d.ts",
    "tsconfig.json",
    "plugins/react-effects.js"
  ],
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --test test/presets.test.js",
    "check": "oxlint && oxfmt --check && npm test"
  },
  "peerDependencies": {
    "oxfmt": ">=0.76.0",
    "oxlint": ">=1.91.0",
    "oxlint-tsgolint": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005"
  }
}
